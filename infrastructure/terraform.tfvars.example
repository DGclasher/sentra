project_name = "sentra"
environment  = "production"
aws_region   = "us-east-1"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = []
enable_nat_gateway    = true
single_nat_gateway    = false

public_albs = false
enable_https = false
acm_certificate_arn = ""
api_gateway_stage_name = "$default"

cognito_callback_urls = ["http://localhost:3000/callback"]
cognito_logout_urls   = ["http://localhost:3000/logout"]

billing_mode                         = "PAY_PER_REQUEST"
enable_dynamodb_pitr                  = true
enable_dynamodb_deletion_protection  = true

lambda_runtime          = "python3.12"
lambda_architecture     = "arm64"

ecs_desired_count = 1
ecs_cpu           = 256
ecs_memory        = 512
ticket_service_cpu = 256
ticket_service_memory = 512
ai_service_cpu = 512
ai_service_memory = 2048
identity_service_cpu = 256
identity_service_memory = 512

ticket_service_image   = "dgclasher/sentra-ticket-service:latest"
ai_service_image       = "dgclasher/sentra-ai-service:latest"
identity_service_image = "dgclasher/sentra-identity-service:latest"

dockerhub_credentials_secret_arn = ""
groq_api_key = ""
embedding_model = "sentence-transformers/all-MiniLM-L12-v2"

s3_doc_storage_bucket_name = "sentra-ai-doc-bucket"
s3_vector_bucket_name      = "sentra-ai-bucket"
s3_vector_index_name       = "sentra-ai-bucket-index"
s3_vector_dimension        = 384

target_health_check = {
  interval            = 30
  timeout             = 5
  healthy_threshold   = 2
  unhealthy_threshold = 3
}
