# Cognito Configuration
COGNITO_DOMAIN=your-cognito-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_REGION=us-east-1

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=Users
DYNAMODB_ENDPOINT_URL=http://localhost:8000  # For local DynamoDB testing, leave empty for AWS

# Service URLs (for local development)
IDENTITY_SERVICE_URL=http://localhost:8000
TICKET_SERVICE_URL=http://localhost:8001
AI_SERVICE_URL=http://localhost:8002

# Database (placeholder - future implementation)
DATABASE_URL=postgresql://user:password@localhost:5432/sentra

# Bedrock Configuration (future implementation)
BEDROCK_MODEL_ID=anthropic.claude-v2
BEDROCK_KNOWLEDGE_BASE_ID=your-kb-id

# S3 Configuration (future implementation)
S3_BUCKET_NAME=sentra-bucket

# SQS Configuration (future implementation)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account-id/queue-name
